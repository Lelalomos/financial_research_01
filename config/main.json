{
  "data": {
    "sources": {
      "START_DATE": "2000-01-01",
      "END_DATE": null,
      "SP500_TICKER_SOURCE": "wikipedia",
      "USE_YFINANCE_LIVE": true,
      "INDEX_FILE": "GSPC.json",
      "RAW_DATA_INDEX_PATH": "raw_data/index",
      "VIX_SYMBOL": "^VIX",
      "COMMODITIES": {
        "GC=F": "Gold",
        "HG=F": "Copper",
        "ZC=F": "Corn",
        "ZS=F": "Soybeans",
        "CC=F": "Cocoa",
        "SI=F": "Silver"
      },
      "TREASURY_YIELDS": ["DGS10", "DGS30", "DGS2"]
    },
    "splits": {
      "TRAIN_RATIO": 0.7,
      "TEST_RATIO": 0.2,
      "VAL_RATIO": 0.1
    },
    "sequences": {
      "SEQUENCE_LENGTH": 30,
      "PREDICTION_HORIZON": 5,
      "TARGET_THRESHOLD": 2.0,
      "NORMALIZE_TARGET": true,
      "STRIDE": 1
    },
    "dataset": {
      "MODE": "precomputed_sequences"
    },
    "technical_indicators": {
      "EMA_PERIODS": [50, 200],
      "RSI_PERIOD": 14,
      "STOCHRSI_PERIOD": 14,
      "MACD_PARAMS": [12, 26, 9]
    },
    "fibonacci": {
      "FIBONACCI_WINDOW": 3
    },
    "geometric": {
      "CHANNEL_WINDOW": 7,
      "SWING_WINDOW": 7,
      "TRENDLINE_WINDOW": 15,
      "TRENDLINE_TOLERANCE": 0.0001,
      "TRENDLINE_MAX_ITERATIONS": 100,
      "ENABLE_ATR_FEATURE": true,
      "ENABLE_ROC_FEATURE": true,
      "ENABLE_BB_WIDTH_FEATURE": true,
      "ENABLE_SLOPE_FEATURES": true,
      "ENABLE_CHANNEL_COMPRESSION": true,
      "ENABLE_CHANNEL_POSITION": true,
      "ENABLE_SWING_DISTANCE": true,
      "ENABLE_SWING_TIME_DISTANCE": true,
      "ENABLE_OPTIMIZED_TRENDLINES": true,
      "ENABLE_OPTIMIZED_CHANNEL_WIDTH": true
    },
    "candlestick": {
      "USE_CANDLESTICK_PATTERNS": true,
      "EXCLUDE_PATTERNS": [
        "CDL3STARSINSOUTH",
        "CDLKICKING",
        "CDLKICKINGBYLENGTH",
        "CDLCONCEALBABYSWALL",
        "CDLMATHOLD",
        "CDLABANDONEDBABY",
        "CDLIDENTICAL3CROWS",
        "CDLBREAKAWAY",
        "CDL3BLACKCROWS",
        "CDLRISEFALL3METHODS",
        "CDLUPSIDEGAP2CROWS",
        "CDL2CROWS",
        "CDL3WHITESOLDIERS",
        "CDLCOUNTERATTACK",
        "CDL3LINESTRIKE",
        "CDLINNECK",
        "CDLTRISTAR",
        "CDLLADDERBOTTOM",
        "CDLSTICKSANDWICH",
        "CDLHIKKAKEMOD",
        "CDLUNIQUE3RIVER",
        "CDLMORNINGDOJISTAR",
        "CDLEVENINGDOJISTAR",
        "CDLONNECK",
        "CDLSTALLEDPATTERN",
        "CDLGAPSIDESIDEWHITE",
        "CDLPIERCING",
        "CDLDARKCLOUDCOVER",
        "CDLSEPARATINGLINES"
      ]
    },
    "sector": {
      "SECTOR_MAPPING_SOURCE": "default",
      "USE_SECTOR_EMBEDDING": true,
      "DEFAULT_SECTOR_MAPPING": {}
    },
    "features": {
      "FEATURE_FLAGS": {
        "price_features": true,
        "ema_features": true,
        "rsi_features": true,
        "stochrsi_features": true,
        "macd_features": true,
        "geometric_features": true,
        "fibonacci_features": true,
        "candlestick_patterns": true,
        "vix": true,
        "commodities": true,
        "treasury_yields": true,
        "time_features": true,
        "financial_metrics": true,
        "market_regime": true,
        "polars_fibonacci_features": true,
        "polars_time_features": true,
        "polars_external_merges": true
      }
    },
    "regime": {
      "ENABLED": true,
      "METHOD": "quantile",
      "PROXY_COLUMN": "vix",
      "N_REGIMES": 3,
      "LOW_QUANTILE": 0.33,
      "HIGH_QUANTILE": 0.66,
      "DEFAULT_REGIME": 1
    },
    "normalization": {
      "NORMALIZATION_METHOD": "robust",
      "LOG_TRANSFORM_OFFSET": 1.0
    },
    "filtering": {
      "MIN_TRADING_DAYS": 252,
      "MAX_MISSING_RATIO": 0.1
    },
    "external_data": {
      "EXTERNAL_DATA_FILL_METHOD": "ffill",
      "MAX_EXTERNAL_FILL_DAYS": 5
    },
    "download": {
      "DOWNLOAD_RETRY_ATTEMPTS": 5,
      "DOWNLOAD_RETRY_DELAY": 5
    },
    "financial_metrics": {
      "USE_FINANCIAL_METRICS": true,
      "FINANCIAL_METRICS_SOURCE": "raw_data/ticket_data/us",
      "FINANCIAL_METRICS_FILL_METHOD": "ffill"
    },
    "validation": {
      "REQUIRED_COLUMNS": {
        "identifiers": ["date", "tic"],
        "price_data": ["open", "high", "low", "close", "volume"],
        "target": ["target"]
      },
      "OPTIONAL_COLUMNS": {
        "financial_metrics": ["pe_ratio", "peg_ratio", "eps", "dividend_flag", "roe", "roi", "debt_to_equity", "debt_to_asset", "current_ratio"],
        "geometric": ["atr_14_norm", "roc_10", "bb_width_20", "slope_sup_20", "slope_res_20", "channel_compression_20", "channel_position_20", "dist_to_swing_high_20", "dist_to_swing_low_20", "days_since_swing_high_20", "days_since_swing_low_20", "opt_slope_sup_30", "opt_slope_res_30", "opt_channel_width_30"],
        "fibonacci": ["swing_high", "swing_low", "fib_range", "fib_38", "fib_50", "fib_61", "dist_fib_38", "dist_fib_50", "dist_fib_61", "break_fib_61"],
        "time_features": ["day", "month", "dayofweek"],
        "external": ["vix", "bondyield"],
        "market_regime": ["regime_id"],
        "grouping": ["group"],
        "categorical_encoded": ["tic_id", "group_id"]
      },
      "VALIDATE_ON_LOAD": true,
      "WARN_ON_MISSING_OPTIONAL": true
    },
    "paths": {
      "RAW_DATA_PATH": "data/raw",
      "PROCESSED_DATA_PATH": "data/processed",
      "SPLITS_PATH": "data/splits",
      "EXTERNAL_DATA_PATH": "data/external"
    }
  }
}
